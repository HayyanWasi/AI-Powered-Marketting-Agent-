# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Database URL (PostgreSQL via Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# LLM Endpoint (OpenAI-compatible — e.g. Ollama behind a tunnel)
# All LLM traffic routes here. The URL must end at /v1; the SDK appends
# /chat/completions itself. Update LLM_BASE_URL whenever the tunnel restarts.
LLM_BASE_URL=https://alphabetical-gui-tahoe-vpn.trycloudflare.com/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama

# Planning-only Ollama endpoints (two independent GPUs). Planning lanes use
# these; intake/video keep LLM_BASE_URL. Leave empty to run planning on the
# remote provider chain only. URLs end at /v1.
PLANNING_OLLAMA_A_BASE_URL=
PLANNING_OLLAMA_A_MODEL=qwen3:8b
PLANNING_OLLAMA_B_BASE_URL=
PLANNING_OLLAMA_B_MODEL=qwen3:8b

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Feature Flags
ENABLE_ASSET_STORAGE=true
ENABLE_PUBLISHING_QUEUE=false

# Public callback + frontend URLs for in-app LinkedIn Hosted Auth.
# APP_PUBLIC_BASE_URL MUST be an HTTPS URL that Unipile can reach from the public
# internet — it is where Unipile POSTs the connection result (notify callback).
# NEVER leave this as localhost in a real connect flow: an external service
# cannot call back to localhost, so the account is never persisted.
#   - Deployed: use the backend's public URL (e.g. https://<app>.onrender.com)
#   - Local dev: expose localhost:8000 through a public HTTPS tunnel
#                (e.g. cloudflared/ngrok) and use that tunnel URL here.
# FRONTEND_BASE_URL is where Unipile sends the user back after Hosted Auth.
APP_PUBLIC_BASE_URL=https://your-backend.example.com
FRONTEND_BASE_URL=http://localhost:3000

# LinkedIn Mock Mode (set true for development — no real API calls)
USE_MOCK_UNIPILE=false
UNIPILE_DSN=https://api1.unipile.com:13111
UNIPILE_TOKEN=6nxl47d7.K4s7yK3IleEUO7H4wmZZTqLGXOlmDXYJ6fKZBnTR+nE=
UNIPILE_ACCOUNT_ID=
LINKEDIN_AUTO_ENGAGEMENT_ENABLED=true
LINKEDIN_DAILY_INVITE_LIMIT=25
LINKEDIN_DAILY_LIKE_LIMIT=40
LINKEDIN_DAILY_COMMENT_LIMIT=15
LINKEDIN_TIMEZONE=Asia/Karachi
LINKEDIN_HOSTED_AUTH_SIGNING_SECRET=change-me-to-a-secure-random-32char-secret

# Video Generation
IMAGEMAGICK_BINARY=/usr/bin/convert
