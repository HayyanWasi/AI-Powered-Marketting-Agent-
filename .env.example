# LLM Configuration (Groq primary, Gemini fallback)
GOOGLE_API_KEY=your_google_key_here
GROK_API_KEY=your_groq_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Cloudflare Workers AI (free image generation — img2img with reference, text2img fallback)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_AI_TOKEN=your_cloudflare_workers_ai_token_here
CLOUDFLARE_IMG2IMG_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img
CLOUDFLARE_TEXT2IMG_MODEL=@cf/black-forest-labs/flux-1-schnell

# Image Validation
MIN_IMAGE_WIDTH=1080
MIN_IMAGE_HEIGHT=1080
IMAGE_VALIDATION_TIMEOUT_SECONDS=10

# Application Configuration
LOG_LEVEL=INFO
SESSION_TIMEOUT_HOURS=24

# DDGS Configuration
DDGS_TIMEOUT_SECONDS=15
DDGS_RATE_LIMIT_SECONDS=5

# Observability (optional — telemetry degrades to local JSON logs when unset)
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=ai-marketing-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ai-marketing-agent-operations
